# Copy to .env and fill in. Never commit .env.
BRAND=DhanKhoj
BASE_URL=https://your-domain.in
HOST=127.0.0.1
PORT=8080
DB_PATH=data/dhankhoj.db
ADMIN_TOKEN=   # long random string; enables /admin.html
APP_SALT=               # long random string; used to hash OTPs
DEV_MODE=0              # 1 = return OTPs in API (local testing ONLY)
TRUST_PROXY=0           # 1 when behind nginx (uses X-Forwarded-For for rate limits)
WORKER_INTERVAL=120     # seconds; 0 = use worker.py / cron instead

# Providers: email = console|smtp, sms = console|twilio|msg91, whatsapp = console|twilio|meta
EMAIL_PROVIDER=console
SMS_PROVIDER=console
WA_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_MODE=starttls      # starttls | ssl
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_SMS_FROM=
TWILIO_MESSAGING_SID=
TWILIO_WA_FROM=whatsapp:+14155238886
MSG91_AUTHKEY=
MSG91_OTP_TEMPLATE_ID=     # DLT-approved template id
MSG91_ALERT_TEMPLATE_ID=
META_WA_TOKEN=
META_WA_PHONE_ID=
META_WA_OTP_TEMPLATE=
META_WA_ALERT_TEMPLATE=
META_WA_LANG=en

# ---- Accounts, plan and payments ----
DATA_KEY=               # long random string; encrypts PAN at rest. Never change it after launch (you would lose the PANs)
SESSION_DAYS=14
SECURE_COOKIES=         # leave empty: turns on automatically when BASE_URL starts with https://
FREE_COMPANIES=1        # companies a free account can see in full (latest year only)
# Memberships (prices include GST). Yearly = monthly x 12 less YEARLY_DISCOUNT_PERCENT, or set <TIER>_YEARLY_INR.
YEARLY_DISCOUNT_PERCENT=20
SILVER_MONTHLY_INR=49
SILVER_COMPANIES=25     # Silver: email + SMS
GOLD_MONTHLY_INR=99
GOLD_COMPANIES=100      # Gold: email + SMS + WhatsApp
PLATINUM_MONTHLY_INR=199
PLATINUM_COMPANIES=unlimited
GST_PERCENT=18          # only used on receipts; 0 if you are not GST-registered
BUSINESS_NAME=
GSTIN=
SUPPORT_EMAIL=
# PAY_PROVIDER: empty = payments off | mock (needs DEV_MODE=1, for testing) | razorpay
PAY_PROVIDER=
# Sign in with Google (optional - the buttons stay hidden until both are set).
# console.cloud.google.com > APIs & Services > Credentials > Create credentials > OAuth client ID > Web application.
# Authorised redirect URI:  <BASE_URL>/auth/google/callback   (e.g. https://dhankhoj.in/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=   # set the same value in Razorpay dashboard > Webhooks (events: payment.captured, order.paid)
# Direct UPI (no gateway fee): customer pays your UPI ID and submits the UTR, you approve it in /admin.html
UPI_VPA=
UPI_PAYEE=

# Crawler (needs outbound internet from the server)
CRAWL_ENABLED=0

# Sign users out after this many idle minutes (0 = never). The browser also warns 30 seconds before.
SESSION_IDLE_MIN=5

# LOCAL DEMO ONLY (needs DEV_MODE=1): the Search button shows 6-10 random sample rows, different every time, for this one account
# DUMMY_DATA_EMAIL=chetanpalliwal13@gmail.com

# ---- Contact page (shown publicly) ----
SUPPORT_EMAIL=
SUPPORT_PHONE=
SUPPORT_WHATSAPP=       # digits with country code, e.g. 919876543210
SUPPORT_HOURS=Mon-Sat, 10:00 to 18:00 IST
OFFICE_ADDRESS=
